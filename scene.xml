<mujoco model="auto_repair_workstation">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint armature="0.1" damping="1" limited="true"/>
    <geom condim="4" friction="1 0.1 0.1" rgba="0.8 0.8 0.8 1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.2 0.3 0.5" rgb2="0.1 0.15 0.25" width="200" height="200"/>
    <texture name="ground" type="2d" builtin="checker" rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4" width="300" height="300"/>
    <material name="ground_mat" texture="ground" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- 地面 -->
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="ground_mat"/>

    <!-- 工作台 -->
    <body name="table" pos="0.5 0 0.75">
      <geom name="table_top" type="box" size="0.6 0.4 0.03" pos="0 0 0"/>
      <geom name="table_leg1" type="box" size="0.03 0.03 0.75" pos="-0.55 -0.35 -0.375"/>
      <geom name="table_leg2" type="box" size="0.03 0.03 0.75" pos="0.55 -0.35 -0.375"/>
      <geom name="table_leg3" type="box" size="0.03 0.03 0.75" pos="-0.55 0.35 -0.375"/>
      <geom name="table_leg4" type="box" size="0.03 0.03 0.75" pos="0.55 0.35 -0.375"/>
    </body>

    <!-- 电池包（汽车高压电池包，绿色长方体） -->
    <body name="battery_pack" pos="0.6 0.1 0.81">
      <geom name="battery" type="box" size="0.3 0.2 0.08" rgba="0.1 0.6 0.2 1"/>
      <!-- 高压警示标签 -->
      <geom name="hv_label" type="box" size="0.15 0.1 0.005" pos="0 0 0.085" rgba="0.9 0.8 0.1 1"/>
    </body>

    <!-- 绝缘工具（红色圆柱体，模拟绝缘扳手） -->
    <body name="insulated_tool" pos="0.3 -0.25 0.78">
      <geom name="tool" type="cylinder" size="0.02 0.15" rgba="0.8 0.1 0.1 1"/>
    </body>

    <!-- 6-DOF 机械臂基座（固定在工作台旁） -->
    <body name="robot_base" pos="-0.3 0 0.05">
      <geom name="base" type="cylinder" size="0.1 0.05" rgba="0.2 0.2 0.2 1"/>

      <!-- 关节1：旋转腰 -->
      <body name="joint1" pos="0 0 0.05">
        <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom name="link1" type="capsule" fromto="0 0 0 0 0 0.3" size="0.04" rgba="0.3 0.3 0.8 1"/>

        <!-- 关节2：大臂 -->
        <body name="joint2" pos="0 0 0.3">
          <joint name="j2" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
          <geom name="link2" type="capsule" fromto="0 0 0 0.3 0 0" size="0.035" rgba="0.3 0.5 0.8 1"/>

          <!-- 关节3：小臂 -->
          <body name="joint3" pos="0.3 0 0">
            <joint name="j3" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
            <geom name="link3" type="capsule" fromto="0 0 0 0.25 0 0" size="0.03" rgba="0.3 0.7 0.8 1"/>

            <!-- 关节4：腕旋转 -->
            <body name="joint4" pos="0.25 0 0">
              <joint name="j4" type="hinge" axis="1 0 0" range="-3.14 3.14"/>
              <geom name="link4" type="capsule" fromto="0 0 0 0 0 0.08" size="0.025" rgba="0.3 0.8 0.8 1"/>

              <!-- 关节5：腕俯仰 -->
              <body name="joint5" pos="0 0 0.08">
                <joint name="j5" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
                <geom name="link5" type="capsule" fromto="0 0 0 0 0 0.06" size="0.02" rgba="0.5 0.8 0.8 1"/>

                <!-- 关节6：夹爪旋转 + 末端 site -->
                <body name="joint6" pos="0 0 0.06">
                  <joint name="j6" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
                  <geom name="gripper" type="box" size="0.03 0.03 0.05" rgba="0.6 0.6 0.6 1"/>
                  <site name="ee_site" pos="0 0 0.05" size="0.02" rgba="1 0 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- 目标点：电池包上方（要机械臂到达的位置） -->
    <site name="target" pos="0.6 0.1 0.95" size="0.03" rgba="1 1 0 0.5"/>
  </worldbody>

  <actuator>
    <motor name="m1" joint="j1" gear="100"/>
    <motor name="m2" joint="j2" gear="100"/>
    <motor name="m3" joint="j3" gear="100"/>
    <motor name="m4" joint="j4" gear="50"/>
    <motor name="m5" joint="j5" gear="50"/>
    <motor name="m6" joint="j6" gear="20"/>
  </actuator>
</mujoco>
